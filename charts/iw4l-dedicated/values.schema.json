{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "iw4l-dedicated values",
  "description": "Strict where the chart defines the structure (unknown keys and wrong types fail the render); free-form where values pass through to Kubernetes. values.yaml describes each value.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "k8sObject": { "type": "object" },
    "k8sList": { "type": "array" },
    "storageSize": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$" },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "exec": false,
        "httpGet": false,
        "tcpSocket": false,
        "grpc": false,
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "number"] },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "replicas": { "type": "integer", "minimum": 0, "maximum": 1 },
    "zone": { "type": "string", "pattern": "^[A-Za-z0-9_]+(:[A-Za-z0-9_]+)?$" },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "pattern": "^(([A-Za-z0-9.-]+|\\[[0-9A-Fa-f:.]+\\]):[0-9]{1,5})?$" },
        "serverName": { "type": "string", "minLength": 1 },
        "keySha256": { "type": "string", "pattern": "^(([0-9A-Fa-f]{2}:?){31}[0-9A-Fa-f]{2})?$" }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 48, "pattern": "^(.*\\S.*)?$" },
        "maxPlayers": { "type": "integer", "anyOf": [{ "const": 0 }, { "minimum": 2, "maximum": 18 }] },
        "password": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "adminKeys": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
      "uniqueItems": true
    },
    "minecraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "world": { "type": "string", "pattern": "^([A-Za-z0-9_.-]+)?$" }
      }
    },
    "gameData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": { "type": "string" },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "volume": { "$ref": "#/definitions/k8sObject" },
        "subPath": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "size": { "$ref": "#/definitions/storageSize" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
        },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "emptyDirSizeLimit": { "$ref": "#/definitions/storageSize" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": { "type": "string" },
        "volume": { "$ref": "#/definitions/k8sObject" },
        "subPath": { "type": "string" }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "extraVolumes": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object", "required": ["name", "mountPath"] } },
    "deploymentLabels": { "$ref": "#/definitions/stringMap" },
    "deploymentAnnotations": { "$ref": "#/definitions/stringMap" },
    "strategy": {
      "type": "object",
      "properties": { "type": { "enum": ["Recreate", "RollingUpdate"] } }
    },
    "resources": { "$ref": "#/definitions/k8sObject" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "affinity": { "$ref": "#/definitions/k8sObject" },
    "tolerations": { "$ref": "#/definitions/k8sList" },
    "priorityClassName": { "type": "string" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podSecurityContext": { "$ref": "#/definitions/k8sObject" },
    "securityContext": { "$ref": "#/definitions/k8sObject" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "defaultServiceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "manage": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "to": { "type": "array", "minItems": 1, "items": { "type": "object" } } }
        },
        "master": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "to": { "type": "array", "items": { "type": "object" } } }
        },
        "internet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": { "type": "string", "minLength": 1 },
            "except": { "type": "array", "items": { "type": "string" } },
            "tcpPorts": { "type": "array", "items": { "$ref": "#/definitions/port" } }
          }
        },
        "extraIngress": { "type": "array", "items": { "type": "object" } },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "extraObjects": { "type": "array", "items": { "type": "object" } }
  }
}
